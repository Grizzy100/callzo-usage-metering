
NODE_ENV=development
PORT=3000

# Local PostgreSQL connection
DATABASE_URL=postgresql://callzo:callzo_password@localhost:5432/callzo
DIRECT_URL=postgresql://callzo:callzo_password@localhost:5432/callzo

# Webhook verification
WEBHOOK_SECRET=replace_with_webhook_secret

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
ADMIN_API_KEY=replace_with_admin_api_key

# Account configuration
DEFAULT_MONTHLY_CAP_SECONDS=600

# Docker PostgreSQL
POSTGRES_USER=callzo
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=callzo
